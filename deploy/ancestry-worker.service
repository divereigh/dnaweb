# RETIRED 2026-09-09 — the dna_notes → Ancestry push-back is no longer
# used. Several kits were never set up to receive notes, so the push
# only ever worked for some of them, and we no longer need notes to
# round-trip at all: they are local to this app now. DnaNoteController
# writes pushreq=0 as of the same date, so this worker would find
# nothing to do even if it were running.
#
# Turn it off on the box that runs it (the loader host, not the VPS):
#   sudo systemctl disable --now ancestry-worker.service
#
# The unit and worker-ancestry.pl are kept rather than deleted: the
# Ancestry endpoint and the session handling in it are the only worked
# example of writing back to Ancestry, and re-enabling is a matter of
# restoring pushreq=1 in DnaNoteController.
#
# --- Original header ---
#
# systemd unit for the dna_notes → Ancestry push worker.
#
# Installed at /etc/systemd/system/ancestry-worker.service.
# Drains dna_notes rows with pushreq=1, POSTs the notes to the
# Ancestry tags/3 endpoint, clears pushreq on success.
#
# Single instance — the operation is idempotent so multiple workers
# would be safe, but there's rarely enough traffic to justify it.
#
# Enable + start:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ancestry-worker.service
#
# Tail logs:
#   journalctl -u ancestry-worker.service -f
#
# DB credentials come from the same ~/.config/ancestry/db.env file
# the match2match worker uses (see match2match-worker@.service for
# the setup recipe).

[Unit]
Description=DNA notes → Ancestry push worker
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=damo
WorkingDirectory=/home/damo/ancestry-program
EnvironmentFile=/home/damo/.config/ancestry/db.env
ExecStart=/usr/bin/perl ./worker-ancestry.pl
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
